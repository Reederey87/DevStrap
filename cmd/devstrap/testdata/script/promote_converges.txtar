# NOVCS-03: `devstrap promote` converges across devices through the EXISTING
# project.updated event, and does so WITHOUT raising a conflict anywhere.
#
# That last assertion is the point of this script. `promote --git-remote`
# announces a remote where the namespace map previously had none, which looks
# like it should collide with the shipped same-path/different-remote
# reconciliation. It does not: decideUpsert's conflict branch is guarded by
# `existing.RemoteKey != ""`, and every promotion source has an empty remote
# key, so the event falls through to plain HLC last-writer-wins. Nothing else
# in the codebase pins that guard from the promote side — without the
# `No open conflicts` assertion below, a future edit to decideUpsert would
# silently start raising a conflict on every promotion in the fleet.

env DEVSTRAP_NO_KEYCHAIN=1
env GIT_AUTHOR_NAME=devstrap-test
env GIT_AUTHOR_EMAIL=test@example.com
env GIT_COMMITTER_NAME=devstrap-test
env GIT_COMMITTER_EMAIL=test@example.com

# The promotion target: an EMPTY bare remote. promote refuses a remote that
# already holds refs, so this must start with nothing in it.
exec git init --bare -b main $WORK/promoted.git

# Device A: a git repo inside the managed root with NO remote, adopted as
# local_git (NOVCS-01) — the "forgot to push" population promote exists for.
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA init
exec git init -b main $WORK/CodeA/work/unpushed
exec sh -c 'cd $WORK/CodeA/work/unpushed && echo one > a.txt && git add a.txt && git commit -m one'
exec sh -c 'cd $WORK/CodeA/work/unpushed && echo two > b.txt && git add b.txt && git commit -m two'
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA scan --adopt
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA status
stdout 'work/unpushed\s+local_git'

# Device B joins: init, enroll+approve on A so A grants it the WCK epochs.
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB init
exec sh -c 'REC=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices recipient); SIG=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices recipient --signing); FP=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices recipient --fingerprint); devstrap --home=$WORK/homeA --root=$WORK/CodeA devices enroll dev_b --name b --os linux --arch arm64 --age-recipient "$REC" --signing-public-key "$SIG" --approve --fingerprint "$FP"'
stdout 'enrolled as approved'

# Both devices converge on the pre-promotion state: B knows the project as
# local_git (its content would ride the encrypted bundle plane, never a clone).
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB status
stdout 'work/unpushed\s+local_git'

# Device A promotes: the EXISTING two commits are pushed to the empty remote.
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA promote work/unpushed --git-remote=$WORK/promoted.git
stdout 'local_git -> git_repo'
exec sh -c 'test "$(git -C $WORK/promoted.git rev-list --count main)" = 2'
exec sh -c 'test "$(git -C $WORK/promoted.git rev-parse main)" = "$(git -C $WORK/CodeA/work/unpushed rev-parse HEAD)"'

# Device B pulls the promotion.
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB sync --hub-file=$WORK/hub.json

# B's type changed, and B now eagerly clones the repo it previously could not.
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB status
stdout 'work/unpushed\s+git_repo'
exec sh -c 'test -d $WORK/CodeB/work/unpushed/.git'
exec sh -c 'cat $WORK/CodeB/work/unpushed/b.txt'
stdout 'two'

# THE assertion this script exists for: announcing a remote where there was
# none raised no conflict on either device.
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB conflicts list
stdout 'No open conflicts'
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA conflicts list
stdout 'No open conflicts'
