# P7-WIP-07: aged WIP refs are enumerated without creating local refs, dry-run
# is side-effect free, deletion is leased and propagated, and foreign
# workspace orphans are permanently retained.
env DEVSTRAP_NO_KEYCHAIN=1
env GIT_AUTHOR_NAME=devstrap-test
env GIT_AUTHOR_EMAIL=test@example.com
env GIT_COMMITTER_NAME=devstrap-test
env GIT_COMMITTER_EMAIL=test@example.com

exec git init --bare -b main $WORK/rem1.git
exec git clone $WORK/rem1.git $WORK/src
exec sh -c 'echo hello > $WORK/src/README.md'
exec sh -c 'cd $WORK/src && git add README.md && git commit -m init && git push origin main'

exec devstrap --home=$WORK/homeA --root=$WORK/CodeA init
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA add --path work/proj $WORK/rem1.git
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json

exec devstrap --home=$WORK/homeB --root=$WORK/CodeB init
exec sh -c 'REC=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices recipient); SIG=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices recipient --signing); FP=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices recipient --fingerprint); devstrap --home=$WORK/homeA --root=$WORK/CodeA devices enroll dev_b --name b --os linux --arch arm64 --age-recipient "$REC" --signing-public-key "$SIG" --approve --fingerprint "$FP"'
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB sync --hub-file=$WORK/hub.json

exec sh -c 'echo dirty >> $WORK/CodeA/work/proj/README.md'
exec sh -c 'devstrap --home=$WORK/homeA --root=$WORK/CodeA wip push work/proj > $WORK/push.out'
exec sh -c 'REF=$(sed -n "s#.*\\(refs/devstrap/wip/[^ ]*\\).*#\\1#p" $WORK/push.out); git --git-dir=$WORK/rem1.git show-ref --verify --quiet "$REF"'

exec devstrap --home=$WORK/homeA --root=$WORK/CodeA wip gc work/proj --dry-run --ttl 1ms
stdout 'delete .*own ref past TTL'
exec sh -c 'REF=$(sed -n "s#.*\\(refs/devstrap/wip/[^ ]*\\).*#\\1#p" $WORK/push.out); git --git-dir=$WORK/rem1.git show-ref --verify --quiet "$REF"'

exec devstrap --home=$WORK/homeA --root=$WORK/CodeA wip gc work/proj --ttl 1ms
stdout 'delete .*own ref past TTL'
exec sh -c 'REF=$(sed -n "s#.*\\(refs/devstrap/wip/[^ ]*\\).*#\\1#p" $WORK/push.out); ! git --git-dir=$WORK/rem1.git show-ref --verify --quiet "$REF"'

# Publish the dropped event; the peer receives the tombstone and reports no WIP.
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB wip status work/proj
stdout 'No pending WIP for work/proj'

# A fabricated device segment may belong to another DevStrap workspace sharing
# this origin. It remains visible but is never deleted, across repeated sweeps.
exec sh -c 'git -C $WORK/CodeA/work/proj push origin HEAD:refs/devstrap/wip/dev_foreign/project'
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA wip gc work/proj --ttl 1ms
stdout 'unknown owner; not deleted'
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA wip gc work/proj --ttl 1ms
stdout 'unknown owner; not deleted'
exec git --git-dir=$WORK/rem1.git show-ref --verify --quiet refs/devstrap/wip/dev_foreign/project

# ls-remote enumeration and temporary object inspection leave no local WIP ref.
exec sh -c 'test -z "$(git -C $WORK/CodeA/work/proj for-each-ref refs/devstrap)"'
