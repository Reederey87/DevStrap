# P7-WIP-08: the ordinary convergence path automatically expires an aged WIP
# ref after pull + materialization, and the dropped event clears the fleet mirror.
env DEVSTRAP_NO_KEYCHAIN=1
env GIT_AUTHOR_NAME=devstrap-test
env GIT_AUTHOR_EMAIL=test@example.com
env GIT_COMMITTER_NAME=devstrap-test
env GIT_COMMITTER_EMAIL=test@example.com

exec git init --bare -b main $WORK/remote.git
exec git clone $WORK/remote.git $WORK/src
exec sh -c 'echo hello > $WORK/src/README.md'
exec sh -c 'cd $WORK/src && git add README.md && git commit -m init && git push origin main'

exec devstrap --home=$WORK/homeA --root=$WORK/CodeA init
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA add --path work/proj $WORK/remote.git
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json

# B joins and A enrolls it under the device id captured in B's own pairing
# code. A hardcoded label would not match B's signed event origin.
exec sh -c 'CODE=$(devstrap --home=$WORK/homeA --root=$WORK/CodeA devices pairing-code 2>/dev/null); FP=$(devstrap --home=$WORK/homeA --root=$WORK/CodeA devices recipient --fingerprint); devstrap --home=$WORK/homeB --root=$WORK/CodeB init --join --code "$CODE" --fingerprint "$FP"'
exec sh -c 'BCODE=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices pairing-code 2>/dev/null); BFP=$(devstrap --home=$WORK/homeB --root=$WORK/CodeB devices recipient --fingerprint); devstrap --home=$WORK/homeA --root=$WORK/CodeA devices enroll --code "$BCODE" --approve --fingerprint "$BFP"'
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB sync --hub-file=$WORK/hub.json

exec sh -c 'mkdir -p $WORK/homeB && printf "wip:\\n  gc_interval: 1ms\\n  ttl: 1ms\\n" > $WORK/homeB/config.yaml'
exec sh -c 'echo dirty >> $WORK/CodeB/work/proj/README.md'
exec sh -c 'devstrap --home=$WORK/homeB --root=$WORK/CodeB wip push work/proj > $WORK/push.out'

# Positive control: the exact pushed ref exists before B's plain sync.
exec sh -c 'REF=$(sed -n "s#.*\\(refs/devstrap/wip/[^ ]*\\).*#\\1#p" $WORK/push.out); git --git-dir=$WORK/remote.git show-ref --verify --quiet "$REF"'
exec sleep 0.01

exec devstrap --config=$WORK/homeB/config.yaml --home=$WORK/homeB --root=$WORK/CodeB sync --hub-file=$WORK/hub.json
stdout 'GC.d 1 WIP recovery ref'
exec sh -c 'REF=$(sed -n "s#.*\\(refs/devstrap/wip/[^ ]*\\).*#\\1#p" $WORK/push.out); ! git --git-dir=$WORK/remote.git show-ref --verify --quiet "$REF"'

# A learns B's dropped event and no pending recovery row remains.
exec devstrap --home=$WORK/homeB --root=$WORK/CodeB sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA sync --hub-file=$WORK/hub.json
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA wip status work/proj
stdout 'No pending WIP for work/proj'
exec devstrap --home=$WORK/homeA --root=$WORK/CodeA doctor
! stdout 'wip: work/proj'
